# ==============================================================================
# Copy to .env.local and fill in. .env.local is git-ignored.
# ==============================================================================

# --- Supabase --------------------------------------------------------------
# Project Settings -> API. These two are safe in the browser: the anon key only
# works together with Row Level Security, which this schema enables everywhere.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Azure Speech (SERVER ONLY) --------------------------------------------
# NEVER prefix these with NEXT_PUBLIC_. They are read only inside
# src/app/api/assess/route.ts, which runs on the Node.js server.
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=centralindia

# Optional. Only needed for sovereign clouds or a custom Speech endpoint.
# Defaults to https://{AZURE_SPEECH_REGION}.stt.speech.microsoft.com
# AZURE_SPEECH_ENDPOINT=

# --- Assessment provider ----------------------------------------------------
# "azure" (default), "mms" or "mock".
#
# "mms" uses the free, self-hosted open-source engine in services/speech (Meta
# MMS model, runs on your own machine - no cloud account or card). Start it
# first: see services/speech/README.md. Word pronunciation only; the English
# spoken-spelling check still needs Azure.
#
# "mock" returns deterministic fake scores so the recording UI can be developed
# without any engine. It is hard-blocked in production builds - see
# src/lib/assessment/provider.ts - so it can never produce fake stored results.
# ASSESSMENT_PROVIDER=mms

# --- Open-source engine (SERVER ONLY, only for ASSESSMENT_PROVIDER=mms) -----
# Defaults to the local dev address. Set a token if the service is reachable
# by anything other than this app (start the service with the same value).
# SPEECH_SERVICE_URL=http://127.0.0.1:8765
# SPEECH_SERVICE_TOKEN=
